APP_NAME=Clinical AI Copilot
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

POSTGRES_USER=clinical_ai
POSTGRES_PASSWORD=clinical_ai_dev
POSTGRES_DB=clinical_ai

DATABASE_URL=postgresql+asyncpg://clinical_ai:clinical_ai_dev@postgres:5432/clinical_ai

JWT_SECRET=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# CORS_ALLOW_ORIGINS=["https://app.example.com"]  (leave unset: no browser cross-origin access)

OPENAI_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning (Milestone C/D). Safe to leave unset - Settings
# defaults match these values.
SEMANTIC_TOP_K=15
BM25_TOP_K=15

# Hybrid retrieval / reranking (Milestone D). Safe to leave unset -
# Settings defaults match these values. RERANKER_MODEL is only actually
# loaded if the optional requirements-reranker.txt extra is installed
# (Docker: --build-arg INSTALL_RERANKER=true) - otherwise hybrid
# retrieval falls back to fused (non-reranked) results automatically.
RRF_K=60
RERANKER_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Clinical LangGraph / grounded generation (Milestone E). Safe to leave
# unset - Settings defaults match these values. Generation uses the same
# OPENAI_API_KEY above; no separate secret is introduced. GENERATION_MODEL
# is only actually called when a route/script constructs a real
# OpenAIStructuredLLMProvider - importing/building the graph itself never
# requires OPENAI_API_KEY to be set.
EVIDENCE_SUFFICIENT_THRESHOLD=0.65
EVIDENCE_PARTIAL_THRESHOLD=0.35
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MODERATE_THRESHOLD=0.60
SEVERE_HALLUCINATION_RATE_THRESHOLD=0.30
GENERATION_MODEL=gpt-4o-mini
GENERATION_TEMPERATURE=0.0
MAX_REGENERATION_ATTEMPTS=1

MLFLOW_TRACKING_URI=
REDIS_URL=
